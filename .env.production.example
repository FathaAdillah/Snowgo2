# Dokploy → Compose → Environment. Nilai kosong wajib diisi, kecuali yang ditandai opsional.
# Host example.org hanya contoh. Jangan commit file berisi nilai produksi.
# Isi referensi penuh registry/repo@sha256:<digest> yang sudah dipublikasikan.
SNOWEGO_API_IMAGE=
SNOWEGO_ADMIN_IMAGE=
SNOWEGO_STOREFRONT_IMAGE=

STOREFRONT_HOST=shop.example.org
ADMIN_HOST=admin.example.org
APP_URL=https://shop.example.org
ADMIN_URL=https://admin.example.org
SANCTUM_STATEFUL_DOMAINS=shop.example.org,admin.example.org
EDGE_BIND=127.0.0.1
EDGE_HTTP_PORT=18080
NGINX_CONFIG_DIR=../files/nginx

# base64: + 32 byte acak dalam base64. Jangan ganti antar-rilis.
APP_KEY=
# IP/CIDR proxy privat yang benar pada host ini; jangan isi *.
TRUSTED_PROXIES=
LOG_LEVEL=info

# Optional production read-only operator consoles; default deny. OmniDB stays disabled.
OPERATOR_HORIZON_ENABLED=false
OPERATOR_LOG_VIEWER_ENABLED=false
SESSION_LIFETIME=10080

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=snowego
DB_USERNAME=snowego
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Object storage eksternal; sesuaikan region, path-style dan kedua URL dengan provider.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_USE_PATH_STYLE_ENDPOINT=true
S3_PUBLIC_BUCKET=
S3_PUBLIC_URL=
S3_PRIVATE_BUCKET=
S3_DOWNLOAD_ENDPOINT=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Opsional. Kosongkan jika fitur tidak digunakan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_CO_ID_KEY=
