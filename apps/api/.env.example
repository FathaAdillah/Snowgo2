APP_NAME=Snowego
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://snowego.localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-*; edge Nginx only.
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=snowego
DB_USERNAME=snowego
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=snowego.localhost,admin.snowego.localhost,localhost:3000,localhost:3001

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=snowego-local-

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@snowego.localhost"
MAIL_FROM_NAME="${APP_NAME}"

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_USE_PATH_STYLE_ENDPOINT=true
S3_PUBLIC_BUCKET=snowego-local-catalog
S3_PUBLIC_URL=http://127.0.0.1:9000/snowego-local-catalog
S3_PRIVATE_BUCKET=snowego-local-private
# Host-reachable endpoint used to sign temporary URLs (Host is part of the signature).
S3_TEMPORARY_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
