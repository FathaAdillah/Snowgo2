# Root Compose environment (copied to .env by `make setup`). Dummy values are local-only.
COMPOSE_PROJECT_NAME=snowego

# Hostnames (dev uses *.localhost; staging/prod override)
STOREFRONT_HOST=localhost
ADMIN_HOST=admin.localhost
EDGE_HTTP_PORT=80

# Laravel
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost
ADMIN_URL=http://admin.localhost
LOG_LEVEL=debug
TRUSTED_PROXIES=*

# Customer idle TTL is 7 days (docs/08-SECURITY.md); sessions are stored in PostgreSQL.
SESSION_LIFETIME=10080
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,admin.localhost

# PostgreSQL
DB_DATABASE=snowego
DB_USERNAME=snowego
DB_PASSWORD=snowego-local

# Redis
REDIS_PASSWORD=redis-local

# Object storage (MinIO). Root credential only for minio-init; the API uses the scoped app key.
S3_ROOT_USER=minio-root
S3_ROOT_PASSWORD=minio-root-local
S3_ACCESS_KEY_ID=snowego-app
S3_SECRET_ACCESS_KEY=snowego-app-local
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=snowego-local-catalog
S3_PRIVATE_BUCKET=snowego-local-private
S3_PUBLIC_URL=http://127.0.0.1:9000/snowego-local-catalog
# Optional: browser-reachable S3 origin for presigned GETs; dev defaults to 127.0.0.1:MINIO_API_PORT.
# S3_DOWNLOAD_ENDPOINT=https://objects.example.org
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mail (Mailpit in dev)
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=no-reply@localhost
MAILPIT_UI_PORT=8025

# DB tools (OmniDB, dev only) at http://localhost/db; account is created on first start
DBTOOLS_USER=dbadmin
DBTOOLS_PASSWORD=snowego-dbtools

# Google OAuth sandbox (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
