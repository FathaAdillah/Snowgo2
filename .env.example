# Root Compose environment (copied to .env by `make setup`). Dummy values are local-only.
COMPOSE_PROJECT_NAME=snowego

# Hostnames (dev uses *.localhost; staging/prod override)
STOREFRONT_HOST=snowego.localhost
ADMIN_HOST=admin.snowego.localhost
EDGE_HTTP_PORT=80

# Laravel
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://snowego.localhost
ADMIN_URL=http://admin.snowego.localhost
LOG_LEVEL=debug
TRUSTED_PROXIES=*

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=snowego.localhost,admin.snowego.localhost

# PostgreSQL
DB_DATABASE=snowego
DB_USERNAME=snowego
DB_PASSWORD=snowego-local

# Redis
REDIS_PASSWORD=redis-local

# Object storage (MinIO). Root credential only for minio-init; the API uses the scoped app key.
S3_ROOT_USER=minio-root
S3_ROOT_PASSWORD=minio-root-local
S3_ACCESS_KEY_ID=snowego-app
S3_SECRET_ACCESS_KEY=snowego-app-local
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=snowego-local-catalog
S3_PRIVATE_BUCKET=snowego-local-private
S3_PUBLIC_URL=http://127.0.0.1:9000/snowego-local-catalog
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mail (Mailpit in dev)
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=no-reply@snowego.localhost
MAILPIT_UI_PORT=8025

# Google OAuth sandbox (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
